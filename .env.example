# Reference for every setting. In production these come from GitHub repo variables and secrets
# and are rendered to the container's environment on deploy; use this file for local runs.

# --- Required ---
# Apprise URLs or Discord webhook URLs, comma separated
NOTIFY_URLS=
# The primary Pi-hole's address, e.g. http://pi.hole
PRIMARY_URL=
# An app password for the primary's API
PIHOLE_PASSWORD=
# The secondary Pi-hole's address, and its SSH host key ("ssh-ed25519 AAAA...")
SECONDARY_HOST=
SECONDARY_HOST_KEY=

# --- Optional ---
# Hour of the daily run, in the container's time zone
CHECK_HOUR=9
# Days in a row a list must fail before it's removed
DEAD_AFTER_DAYS=3
# A list with no sign of a change for this long counts as failing. 0 turns this off
ABANDONED_AFTER_DAYS=180
# Where state and the agent's SSH key are kept
STATE_DIR=/var/lib/pihole-agent
